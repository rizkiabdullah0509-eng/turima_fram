APP_NAME="TURIMA FRAM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turima_fram
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=5256000

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@turima.test"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vue dev server (Vite)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173,127.0.0.1:8000,localhost:8000
SESSION_DOMAIN=null

VITE_APP_NAME="${APP_NAME}"

# ---- WAHA (WhatsApp HTTP API - Turima Farm Mandiri) ----
WAHA_URL=http://127.0.0.1:3005
WAHA_API_KEY=turima-secret-key-2026
WAHA_SESSION=default
WAHA_TIMEOUT_MINUTES=15
